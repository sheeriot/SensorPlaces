                                },
                                {
                                    "id": "devices_component",
                                    "name": "Devices Management",
                                    "description": "Handles device registration, configuration, and management",
                                    "technology": "Django Component"
                                },
                                {
                                    "id": "sensors_component",
                                    "name": "Sensors Management",
                                    "description": "Manages individual sensors, their data, and configurations",
